      "label": "Source Name",
      "fieldtype": "Data"
    },
    {
      "fieldname": "source_file",
      "label": "Source File",
      "fieldtype": "Link",
      "options": "File"
    },
    {
      "fieldname": "source_hash",
      "label": "Source Hash",
      "fieldtype": "Data"
    },
    {
      "fieldname": "source_revision",
      "label": "Source Revision",
      "fieldtype": "Data"
    },
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data"
    },
    {
      "fieldname": "mime_type",
      "label": "Mime Type",
      "fieldtype": "Data"
    },
    {
      "fieldname": "version",
      "label": "Version",
      "fieldtype": "Int"
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
